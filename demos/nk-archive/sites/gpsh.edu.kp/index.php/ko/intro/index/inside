<script>
  var actionPanel = "";
  // recalculate the map coords
  function recalculateMapCoords() {
    if (actionPanel == "") return;
    var $img = $(actionPanel + " img.floormap");
    var oiW = $img.data("ow");
    var oiH = $img.data("oh");
    var riW = $img.width();
    var riH = $img.height();
    //alert($img.attr("alt") + "'s floors image's size: (oiW x oiH): " + oiW + " x " + oiH + ", (riW x riH): " + riW+ " x " + riH);
    if (oiW == riW && oiH == riH)
      return;
    var usemap = $img.attr("usemap");
    $(usemap + " area.iframe").each(function (index) {
      var $this = $(this);
      var newcoords = "";
      var shape = $this.attr('shape');
      var orgcoords = $this.data('orgcoords').split(',');
      orgcoords.forEach(function (value, index, array) {
        if ((index % 2) == 0)
          newcoords += Math.round(parseInt(value) * riW / oiW); 
        else
          newcoords += Math.round(parseInt(value) * riH / oiH); 
        newcoords += (index < (orgcoords.length -1)) ? "," : "";
      });
      $this.attr('coords', newcoords);
    });
  }
  $().ready(function() {
    //recalculateMapCoords();
    $(window).resize(recalculateMapCoords);
    $('area.iframe').fancybox({
      type: 'iframe',
      padding: 3
    });
    $(".tabs a").click(function () {
      // save $(this) in a variable for efficiency
      var $this = $(this);
      // hide panels
      $(".panel").hide();
      $(".tabs a.active").removeClass("active");
      // add active state to new tab
      $this.addClass("active").blur();
      // retrieve href from link (is id of panel to display)
      var panel = $this.attr("href");
      // show panel
      $(panel).fadeIn(250);
      // recalculate a map's coords
      actionPanel = panel;
      recalculateMapCoords();
      // call counter
      var title = ($(panel + " img").length) ? $(panel + " img").attr("alt") : null;
      counter("intro/0", title, panel);
      // save an actived panel in cookie
      setCookie("floor_actived_panel", $(panel).attr("id"), 0.1);
      // don't follow link down page
      return (false);
    }); // end click
    // open first tab
    var panelid = getCookie("floor_actived_panel");
    if (panelid == "")
      $(".tabs li:first a").click();
    else
      $(".tabs a[href='#"+panelid+"']").click();
  });
</script>    </div>
