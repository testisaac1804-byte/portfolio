<script type="text/javascript">
    (function($){

        function station_selector(option) {
            $select = $(option).parent();
            $select.nextAll('input[type=hidden]').val( $select.val() );
        }

        $(document).ready(function(){
            $('#depart_date').turnOffAutocomplete();
            $('#return_date').turnOffAutocomplete();
            var departDate = new dhtmlXCalendarObject(["depart_date"]);
            var returnDate = new dhtmlXCalendarObject(["return_date"]);
            departDate.hideTime();
            departDate.setDateFormat("%Y-%m-%d");
            departDate.loadUserLanguage("");
            departDate.attachEvent("onClick", function (){
                $('#depart_date').change();
                returnDate._activeDate = departDate.getDate();
                returnDate.setSensitiveRange(departDate.getDate(), null);
            });

            returnDate.hideTime();
            returnDate.setDateFormat("%Y-%m-%d");
            returnDate.loadUserLanguage("");
            returnDate.attachEvent("onClick", function (){
                $('#return_date').change();
                departDate.setSensitiveRange(null, returnDate.getDate());
            });

                        departDate.setSensitiveRange(bookable_date, null);
            
                        returnDate.setSensitiveRange(bookable_date, null);
            
            $('#booking_num_adu').combobox({maxlen: 2, name: "flight[booking_num_adu]"});
            $('#booking_num_chi').combobox({maxlen: 2, name: "flight[booking_num_chi]"});
            $('#booking_num_inf').combobox({maxlen: 2, name: "flight[booking_num_inf]"});
            $('#booking_class').combobox({readonly: true});

            $('#selector_image').click(toggle_flight_type);

            $('#depart_station').combobox({readonly: true,  label: " ",  width: "305px", _selected: station_selector});
            $('#arrive_station').combobox({readonly: true,  label: " ",  width: "305px", _selected: station_selector});

            $('#btn_next').click(function(){
                setTimeout(function(){
                    validation();
                }, 100);
                return false;
            });

            switch_flight_type("RT");

        });
    })(jQuery);
</script>

