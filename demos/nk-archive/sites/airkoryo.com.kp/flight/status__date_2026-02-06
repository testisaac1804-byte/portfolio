<script type="text/javascript">
    (function($){
        $(document).ready(function(){
            var flightDate = new dhtmlXCalendarObject("status_calendar");
            flightDate.hideTime();
            flightDate.setDateFormat("%Y-%m-%d");
            flightDate.loadUserLanguage("");
            flightDate.setDate("2026-02-06");
            flightDate.attachEvent("onClick", function (){
                var date = flightDate.getFormatedDate("%Y-%m-%d");
                flightDate.hide();
                document.location.href = "http://www.airkoryo.com.kp/flight/status?date="+date;
            });

            $('#date_link').click(function(){
                flightDate.show();
                return false;
            });

            $(document).click(function(){
                flightDate.hide();
            });
        });
    })(jQuery);
</script>


