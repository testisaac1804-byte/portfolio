	function resizeImages() {

	    var windowWidth = $('#media').innerWidth();
	    var width = windowWidth;
	    var height = width * 0.6;

	    $('.banner').css('width', width);
	    $('.banner').css('height', height);
	    $('.animated img').each(function() {
	        var orig_img_width = $(this).data('width');
	        var orig_img_height = $(this).data('height');
	        var orig_img_rate = orig_img_width / orig_img_height;
	        var dest_img_width = width;
	        var dest_img_height = height;
	        var margin_top = 0;
				if (orig_img_rate > 1) {
					dest_img_height =   width / orig_img_rate;
					if (dest_img_height - height > 0) {
						dest_img_height = height;
						dest_img_width = height *orig_img_rate;
					}
				} 
				else{
					dest_img_width = orig_img_rate * height;
					if (dest_img_width - width > 0 ) {
						dest_img_height =  width * orig_img_rate;
						dest_img_width = width;
					}
				} 
				var margin_top = (height - dest_img_height ) / 2; 
	        	$(this).css('width', dest_img_width)
	            .css('height', dest_img_height)
	            .css('margin-top', margin_top)
	            .css('margin-bottom', margin_top);
	    });

	    	 
	}	
	
