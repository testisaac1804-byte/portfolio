<script type="text/javascript">
	
    $('.date-picker').datepicker();

    function decDate()
    {
        var sltDate = $("#date-picker").val();
        exam = Date.parse(sltDate);
        dateObj = new Date(exam); 
        dateObj.setDate(dateObj.getDate()-1);
        var date = dateObj.toISOString();
        date = date.substr(0,10);
        $("#date-picker").attr("value",date) ;
        $('#myForm').submit();
    }

    function incDate()
    {
        var sltDate = $("#date-picker").val();  
        exam = Date.parse(sltDate);
        dateObj = new Date(exam); 
        dateObj.setDate(dateObj.getDate()+1);
        var date = dateObj.toISOString();
        date = date.substr(0,10);

        $("#date-picker").attr("value",date);
        $('#myForm').submit();
    }
    
    function search_r()
    {
    	$('#myForm').submit();
