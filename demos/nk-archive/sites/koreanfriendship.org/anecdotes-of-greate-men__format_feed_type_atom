	<entry>
		<title>Most Admired Mentor</title>
		<link rel="alternate" type="text/html" href="http://koreanfriendship.org/anecdotes-of-greate-men/3-most-admired-mentor"/>
		<published>2016-10-21T09:29:16+00:00</published>
		<updated>2016-10-21T09:29:16+00:00</updated>
		<id>http://koreanfriendship.org/anecdotes-of-greate-men/3-most-admired-mentor</id>
		<author>
			<name>Super User</name>
