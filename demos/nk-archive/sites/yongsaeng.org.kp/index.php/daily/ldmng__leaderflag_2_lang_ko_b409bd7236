    function detailview(idx) {
        if(idx != undefined){
            $.ajax({
                url: "/index.php/daily/detailview",
                type: "post",
                data: {idx: idx},
                success:function (result){
                    var _temp = JSON.parse(result);
                    $('#contents').empty();
                    $('#slider').empty();
                    $('#title').empty();
                    
                    var contents="";
                    var title="";
                                        
                                                contents += _temp[0]['content_ko'].replace(/김일성/g, '<nobr><b>김일성</b></nobr>').replace(/김정일/g, "<nobr><b>김정일</b></nobr>").replace(/김정은/g, '<nobr><b>김정은</b></nobr>');
                            title += _temp[0]['title_ko'].replace(/김일성/g, '<nobr><b>김일성</b></nobr>').replace(/김정일/g, "<nobr><b>김정일</b></nobr>").replace(/김정은/g, '<nobr><b>김정은</b></nobr>');
                    
                    var arrImg = "";
                                                if(_temp[0]['image_ko'] != null) arrImg = _temp[0]['image_ko'].split(/,/);
                                        
                    var imgcontent="";
                    if(arrImg.length > 0 && arrImg[0] != "") {
                        imgcontent +="<div class='product-images'>";
                            for(i=0;i<arrImg.length;i++) {
                                imgcontent +="<div>";
                                    imgcontent +="<div class='image-imitation'>";

                                                                                imgcontent +="<img src='/yongsaeng_data/contents/leader/"+arrImg[i]+"' class='leader-fluid' alt='"+_temp[0]['meta_ko']+"'>";
                                    
                                        
                                    imgcontent +="</div>";
                                imgcontent +="</div>";
                            }
                        imgcontent +="</div>";
                        $('#slider').append(imgcontent);
                    }

                    sendStatistics(title,idx);

                    $('#contents').append(contents);
                    $('#title').append(title);
                    if(imgcontent != "") {
                        slickCarousel();
                        destroyCarousel();
                    }
                }
            });
        }
    }

    

    function mdetailview(idx) {
        if(idx != undefined){
            $.ajax({
                url: "/index.php/daily/detailview",
                type: "post", 
                data: {idx: idx},
                success:function (result){
                    if(result != null) {
                        var _temp = JSON.parse(result);
                        $('#content'+idx).empty();
                        var _title="";
                        
                                                        var retext = _temp[0]['content_ko'].replace(/김일성/g, '<nobr><b>김일성</b></nobr>').replace(/김정일/g, "<nobr><b>김정일</b></nobr>").replace(/김정은/g, '<nobr><b>김정은</b></nobr>');
                                $('#content'+idx).append(retext);
                                _title = _temp[0]['title_ko'];
                        
                        sendStatistics(_title,idx);
                    }
                }
            });
        }
    }

    function slickCarousel() {
        $('.product-images').slick({
            infinite: true,
            slidesToShow: 1,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 2500,
            speed: 500,
        });
    }
    function destroyCarousel() {
      if ($('.product-images').hasClass('slick-initialized')) {
        $('.product-images').slick('destroy');
      }         
    }
    function sendStatistics(curTitle,idx)
    {
        curTitle = getTextFromHtml(curTitle);
        var title = $("#pagename").val()+"-"+curTitle;
        var page = "/index.php/statistics/alizer_count";
        var curType = "기사";
        var curLang = "ko";
        var link_url = window.location.href;
        if(idx !== undefined){
            link_url = link_url.replace("ldmng","rdmng");
            var idxId = link_url.lastIndexOf("&idx=");
            if(idxId >=0 ) link_url = link_url.substr(0,idxId);
            link_url += "&idx=" + idx;
        }
        sendRequest(page, "POST" , 
                {  
                    "title" : title,
                    "type" : curType,
                    "lang" : curLang,
                    "url" : link_url
                });
    }
