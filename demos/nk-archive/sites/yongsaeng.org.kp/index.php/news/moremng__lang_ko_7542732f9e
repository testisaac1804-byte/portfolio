		function showError(text) {
			$('#mtitle').empty();
			$('#mtitle').append(text);
			$('#modal-form').modal('show');
			$(".form-control").css('border','solid 1px #ff0000');
		}

		function containsEnglishAB(text) {
			var i;
			for(i=0; i<text.length; i++) {
				var code = text.charCodeAt(i);
				if((code >= 65 && code <= 90) || (code >= 97 && code <= 123) ||(code == 39))
					return true;
			}
		}
		function contains(text){
			var i;
			for(i=0;i<text.length;i++){
				var code = text.charCodeAt(i);
				if(code == 39)
				return true;
			}
		}

		function text_check(text){
			var str_check=0;
			var aaa1=text;
			var len1=aaa1.length;
			var i1=0;
			var m1=0;
			var j1;
			var astr_0 =',<,>,;,{,},@,#,^,&,|,`,$,%,*,-,+,~,?,(,),[,],:,",/';
			var astr_1=astr_0.split(",");
			for(i1=0;i1<len1;i1++){
				var text_str=aaa1.substring(i1,i1+1);
				for(j1=1;j1<26;j1++){
					if(text_str==astr_1[astr_1.length-j1]){
						m1++;
					}
				}
				if(m1!=0){
					str_check++;
					m1=0;
				}else{
					m1=0;
				}
			}
			return str_check;
		}
