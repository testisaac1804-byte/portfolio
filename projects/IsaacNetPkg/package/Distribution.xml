<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>IsaacNet</title>
    <organization>com.isaac</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="com.isaac.isaacnet"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowedOsVersions>
            <os-version min="12.0"/>
        </allowedOsVersions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.isaac.isaacnet"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.isaac.isaacnet" visible="false">
        <pkg-ref id="com.isaac.isaacnet"/>
    </choice>
    <pkg-ref id="com.isaac.isaacnet" version="1.0" onConclusion="none">IsaacNetComponent.pkg</pkg-ref>
</installer-gui-script>
