{"mode":"Text","hardwareTarget":"brain","textContent":"# Robot Mesh Studio — VEX IQ Python (vexiq API)\n# Autopilot: Random / Spiral / Lawnmower modes\n# Ports (change to match your build):\n#  - Drive: left motors on [1], right motors on [6, 12]\n#  - Distance sensor (front): 2\n#  - Color sensor: 3\n#  - Gyro: 4\n#  - Touch LED: 5\n#  - Rear bumpers: 8, 9\n\nfrom vexiq import *\nimport time, random\n\n# ---------- CONFIG: edit as needed ----------\nLEFT_PORTS  = [1]\nRIGHT_PORTS = [6]     # If you only have one right motor, set [6]\nDIST_PORT   = 10\nCOLOR_PORT  = 2\nGYRO_PORT   = 4\nTL_PORT     = 5\nBUMP_L_PORT = 7\nBUMP_R_PORT = 12\n\nDRIVE_SPEED_FWD   = 45     # % base forward\nDRIVE_SPEED_TURN  = 40     # % for in-place turns\nBACKUP_SPEED      = -40    # %\nBACKUP_TIME       = 0.5    # s\nDIST_OBS_CM       = 15     # obstacle threshold\nSPIRAL_STEP_S     = 0.25   # how often spiral widens\nSPIRAL_DELTA      = 1.5    # decrease steering each step\nROW_TIME_S        = 3.5    # lawnmower: nominal row time (fallback if no gyro)\nLANE_SHIFT_TIME_S = 1.0    # time to shift one lane between rows (fallback)\n\n# If no gyro, approximate time needed per degree at DRIVE_SPEED_TURN\nTURN_SEC_PER_DEG  = 0.008\n\n# ---------- Devices ----------\n# Motors\nleft_motors  = [Motor(p) for p in LEFT_PORTS]\nright_motors = [Motor(p) for p in RIGHT_PORTS]\n\ndef motors_run(ms, pct):\n    for m in ms: m.run(int(pct))\n\ndef motors_off(ms):\n    for m in ms: m.off()\n\n# Sensors (some may be absent; we’ll check dynamically)\ndist   = None\ncolor  = None\ngyro   = None\ntl     = None\nbumpL  = None\nbumpR  = None\n\ntry:\n    dist = Distance(DIST_PORT)\nexcept Exception:\n    dist = None\n\ntry:\n    color = ColorSensor(COLOR_PORT)\nexcept Exception:\n    color = None\n\ntry:\n    gyro = Gyro(GYRO_PORT)\n    # Calibrate/zero if supported\n    try:\n        gyro.calibrate()\n        # wait a moment for calibration\n        time.sleep(1.0)\n    except Exception:\n        pass\nexcept Exception:\n    gyro = None\n\ntry:\n    tl = TouchLed(TL_PORT)\nexcept Exception:\n    tl = None\n\ntry:\n    bumpL = Bumper(BUMP_L_PORT)\n    bumpR = Bumper(BUMP_R_PORT)\nexcept Exception:\n    bumpL = bumpL or None\n    bumpR = bumpR or None\n\n# ---------- Small helpers ----------\ndef touchled_set_color(name):\n    if not tl: return\n    # Try common APIs\n    try:\n        if name == 'red':   tl.set_color(255, 0, 0)\n        if name == 'green': tl.set_color(0, 255, 0)\n        if name == 'blue':  tl.set_color(0, 0, 255)\n    except Exception:\n        try:\n            if name == 'red':   tl.color(255, 0, 0)\n            if name == 'green': tl.color(0, 255, 0)\n            if name == 'blue':  tl.color(0, 0, 255)\n        except Exception:\n            pass\n\ndef touchled_pressed():\n    if not tl: return False\n    try:\n        return bool(tl.is_pressed())\n    except Exception:\n        try:\n            return bool(tl.pressed())\n        except Exception:\n            return False\n\ndef color_name():\n    if not color: return None\n    try:\n        return color.color_name()  # e.g., 'red', 'blue', 'green', etc.\n    except Exception:\n        try:\n            r,g,b = color.rgb()\n            # naive mapping\n            if r > g and r > b and r > 60: return 'red'\n            if g > r and g > b and g > 60: return 'green'\n            if b > r and b > g and b > 60: return 'blue'\n            return None\n        except Exception:\n            return None\n\ndef distance_cm():\n    if not dist: return 999.0\n    try:\n        return float(dist.distance())  # already in cm on many builds\n    except Exception:\n        try:\n            return float(dist.cm())\n        except Exception:\n            return 999.0\n\ndef bumper_pressed(b):\n    if not b: return False\n    try:\n        return bool(b.is_pressed())\n    except Exception:\n        try:\n            return bool(b.pressed())\n        except Exception:\n            return False\n\ndef heading_deg():\n    if not gyro: return None\n    try:\n        return float(gyro.angle())\n    except Exception:\n        try:\n            return float(gyro.value())\n        except Exception:\n            return None\n\ndef drive(left_pct, right_pct):\n    motors_run(left_motors,  left_pct)\n    motors_run(right_motors, right_pct)\n\ndef stop_all():\n    motors_off(left_motors)\n    motors_off(right_motors)\n\ndef drive_for(left_pct, right_pct, seconds):\n    t0 = time.time()\n    drive(left_pct, right_pct)\n    while time.time() - t0 < seconds:\n        time.sleep(0.01)\n    stop_all()\n\ndef in_place_turn_by(deg, turn_pct=DRIVE_SPEED_TURN):\n    # Positive deg = turn left; negative deg = turn right\n    if gyro:\n        h0 = heading_deg()\n        if h0 is None:\n            _turn_time = abs(deg) * TURN_SEC_PER_DEG\n            drive_for(turn_pct if deg > 0 else -turn_pct,\n                      -turn_pct if deg > 0 else turn_pct,\n                      _turn_time)\n            return\n        target = h0 + deg\n        # normalize helper\n        def err():\n            cur = heading_deg()\n            if cur is None: return 0\n            return target - cur\n        # simple P controller\n        while True:\n            e = err()\n            if abs(e) < 2: break\n            spd = max(18, min(turn_pct, int(abs(e) * 0.5)))\n            drive(spd if e > 0 else -spd, -spd if e > 0 else spd)\n            time.sleep(0.01)\n        stop_all()\n    else:\n        _turn_time = abs(deg) * TURN_SEC_PER_DEG\n        drive_for(turn_pct if deg > 0 else -turn_pct,\n                  -turn_pct if deg > 0 else turn_pct,\n                  _turn_time)\n\ndef obstacle_detected():\n    if distance_cm() < DIST_OBS_CM:\n        return True\n    if bumper_pressed(bumpL) or bumper_pressed(bumpR):\n        return True\n    return False\n\ndef backup_and_random_turn():\n    drive_for(BACKUP_SPEED, BACKUP_SPEED, BACKUP_TIME)\n    deg = random.randint(35, 140)\n    if random.choice([True, False]): deg = -deg\n    in_place_turn_by(deg)\n\n# ---------- Modes ----------\nMODE_RANDOM   = 0\nMODE_SPIRAL   = 1\nMODE_LAWN     = 2\nMODE_NAMES    = ['RANDOM', 'SPIRAL', 'LAWNMOWER']\nMODE_COLORS   = ['red', 'blue', 'green']\n\ndef set_mode(mode):\n    touchled_set_color(MODE_COLORS[mode])\n\ndef read_mode_update(cur_mode, last_tl_state):\n    # Color sensor override (show red/blue/green to switch)\n    cn = color_name()\n    if cn == 'red':\n        set_mode(MODE_RANDOM); return MODE_RANDOM, last_tl_state\n    if cn == 'blue':\n        set_mode(MODE_SPIRAL); return MODE_SPIRAL, last_tl_state\n    if cn == 'green':\n        set_mode(MODE_LAWN); return MODE_LAWN, last_tl_state\n\n    # Touch LED to cycle modes (debounced)\n    pressed = touchled_pressed()\n    if pressed and not last_tl_state:\n        cur_mode = (cur_mode + 1) % 3\n        set_mode(cur_mode)\n    return cur_mode, pressed\n\n# ---------- Main loop ----------\nmode = MODE_RANDOM\nset_mode(mode)\nlast_tl = False\n\n# Spiral state\nspiral_steer = 25.0      # start with noticeable arc\nspiral_last  = time.time()\n\n# Lawnmower state\nrow_dir_left = True      # alternate row turns\nrow_start_t  = time.time()\nrow_heading0 = heading_deg() if gyro else None\n\nwhile True:\n    # Check mode changes\n    mode, last_tl = read_mode_update(mode, last_tl)\n\n    if mode == MODE_RANDOM:\n        # drive straight; when obstacle, back up and turn random\n        if obstacle_detected():\n            backup_and_random_turn()\n        else:\n            drive(DRIVE_SPEED_FWD, DRIVE_SPEED_FWD)\n            time.sleep(0.02)\n\n    elif mode == MODE_SPIRAL:\n        # gradually widen spiral (reduce steering over time)\n        now = time.time()\n        if now - spiral_last >= SPIRAL_STEP_S:\n            spiral_steer = max(0.0, spiral_steer - SPIRAL_DELTA)\n            spiral_last = now\n\n        if obstacle_detected():\n            backup_and_random_turn()\n            # restart spiral arc after obstacle\n            spiral_steer = 25.0\n        else:\n            # steer left by default (positive steer reduces right speed)\n            left = DRIVE_SPEED_FWD\n            right = max(10, int(DRIVE_SPEED_FWD - spiral_steer))\n            drive(left, right)\n            time.sleep(0.02)\n\n    elif mode == MODE_LAWN:\n        # keep straight row using gyro if available\n        if obstacle_detected():\n            # end of row or obstacle → perform a U-ish turn: 90, shift, -90\n            stop_all()\n            turn = 90 if row_dir_left else -90\n            in_place_turn_by(turn)\n            # lane shift forward\n            if gyro:\n                drive_for(DRIVE_SPEED_FWD, DRIVE_SPEED_FWD, 0.6)\n            else:\n                drive_for(DRIVE_SPEED_FWD, DRIVE_SPEED_FWD, LANE_SHIFT_TIME_S)\n            in_place_turn_by(-turn)\n            row_dir_left = not row_dir_left\n            row_start_t  = time.time()\n            row_heading0 = heading_deg() if gyro else None\n        else:\n            # continue current row\n            if gyro and row_heading0 is not None:\n                # heading correction\n                h = heading_deg()\n                if h is None:\n                    err = 0\n                else:\n                    err = (row_heading0 - h)\n                # simple P control on heading (clip small)\n                kP = 0.8\n                steer = max(-12, min(12, int(kP * err)))\n                drive(DRIVE_SPEED_FWD + steer, DRIVE_SPEED_FWD - steer)\n            else:\n                # no gyro → straight time-based rows\n                drive(DRIVE_SPEED_FWD, DRIVE_SPEED_FWD)\n                # time out a row periodically to emulate “rows”\n                if time.time() - row_start_t > ROW_TIME_S:\n                    # pretend we hit an end-of-row boundary\n                    stop_all()\n                    turn = 90 if row_dir_left else -90\n                    in_place_turn_by(turn)\n                    drive_for(DRIVE_SPEED_FWD, DRIVE_SPEED_FWD, LANE_SHIFT_TIME_S)\n                    in_place_turn_by(-turn)\n                    row_dir_left = not row_dir_left\n                    row_start_t  = time.time()\n                    row_heading0 = None\n            time.sleep(0.02)","textLanguage":"python","robotConfig":[],"slot":2,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":""}}