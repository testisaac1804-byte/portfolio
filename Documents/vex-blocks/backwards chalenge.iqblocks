r\" id=\"B/7^b|om?/`g`SEvx!E|\"><field name=\"NUM\">0</field></shadow><block type=\"iq_operator_random\" id=\"/uJ@Etb^j/4[Rn.L-^JU\"><value name=\"FROM\"><shadow type=\"math_number\" id=\"_|m|.-9@nsh$NwmKPr6V\"><field name=\"NUM\">1</field></shadow></value><value name=\"TO\"><shadow type=\"math_number\" id=\"zYtu_y$F$btJd,6Nu|~Q\"><field name=\"NUM\">13</field></shadow></value></block></value><next><block type=\"iq_control_if_elseif_else\" id=\"tyFPDUUvQ(k,cA91,5)l\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" branches=\"7\"></mutation><value name=\"CONDITION1\"><block type=\"iq_operator_equal_to\" id=\"5Ww1^-Z`b^;E5nynR[eC\"><value name=\"OPERAND1\"><shadow type=\"math_number\" id=\"0vJncC~!h,W@k.Gdnyhw\"><field name=\"NUM\">0</field></shadow><block type=\"iq_variables_variable\" id=\"uWlB=d^zwC3`o#}T%x`/\"><field name=\"VARIABLE\" id=\"_2.^beQjx|FGt38A,8(E\">myVariable</field></block></value><value name=\"OPERAND2\"><shadow type=\"math_number\" id=\"st}GQ?$P`[PpiG$NnDj!\"><field name=\"NUM\">1</field></shadow></value></block></value><statement name=\"SUBSTACK1\"><block type=\"iq_looks_set_touchled_color\" id=\".gEy50^d|EzocLg6t!bB\"><field name=\"TOUCHLED\">TouchLED5</field><value name=\"COLOR\"><shadow type=\"iq_looks_colorlist\" id=\"s?*2vrCvF[;#[!!=JA!M\"><field name=\"COLOR\">red</field></shadow></value></block></statement><value name=\"CONDITION2\"><block type=\"iq_operator_equal_to\" id=\".s?P?dOJGkCJlI6]oggd\"><value name=\"OPERAND1\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"iq_variables_variable\" id=\"s2O+.sS?(Fek+;0Tx`Su\"><field name=\"VARIABLE\" id=\"_2.^beQjx|FGt38A,8(E\">myVariable</field></block></value><value name=\"OPERAND2\"><shadow type=\"math_number\" id=\"oion}t16V;R4AD@lp(-5\"><field name=\"NUM\">2</field></shadow></value></block></value><statement name=\"SUBSTACK2\"><block type=\"iq_looks_set_touchled_color\" id=\"b30NVALoDJk`c936HM[I\"><field name=\"TOUCHLED\">TouchLED5</field><value name=\"COLOR